# ── Database ─────────────────────────────────────────────────────────────────
# Neon connection string. Dashboard → your project → Connection Details.
# Use the POOLED connection string (the host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Encryption ───────────────────────────────────────────────────────────────
# Encrypts Plaid access tokens at rest. 32 bytes, base64.
#   openssl rand -base64 32
# Losing or changing this makes every stored bank connection undecryptable and
# every institution has to be relinked. Back it up somewhere safe.
ENCRYPTION_KEY="replace-me-with-openssl-rand-base64-32"

# ── Plaid ────────────────────────────────────────────────────────────────────
# dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID="your_plaid_client_id"

# Plaid secrets are per-environment. The app talks to both at once: real
# accounts against production, the demo account against sandbox.
PLAID_SANDBOX_SECRET="your_plaid_sandbox_secret"
PLAID_PRODUCTION_SECRET=""

# Environment used by ordinary accounts. Demo accounts are always sandbox.
PLAID_ENV="sandbox"

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin. Plaid webhooks are only registered when this is HTTPS,
# so on localhost the app falls back to manual "Refresh".
APP_URL="http://localhost:3000"

# ── Google sign-in (optional) ────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# → Web application. Add this to Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://your-domain.com/api/auth/google/callback
# Leave both blank to hide the Google button and use passwords only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Account allowlist ────────────────────────────────────────────────────────
# Only these addresses can sign in or hold a session, whatever the database says.
# Deliberately redundant with invite-only sign-up: the Google OAuth callback is
# reachable by anyone with a Google account, so single-user access should not
# depend on one layer of application logic alone.
# Comma-separate for more than one. Leave blank to fall back to invite-only.
ALLOWED_EMAILS=""

# ── Demo account ─────────────────────────────────────────────────────────────
# Addresses pinned to Plaid Sandbox whatever PLAID_ENV says, comma-separated.
# This is what makes a demo login safe to show people once the app is live:
# anything linked from it can only ever be a fake sandbox institution, never a
# real bank. Enforced as deployment config so no application bug can promote a
# demo account to production.
DEMO_EMAILS=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Authorizes /api/cron/snapshot. Vercel sends this automatically once set as an
# environment variable in the project.
#   openssl rand -hex 32
CRON_SECRET="replace-me-with-openssl-rand-hex-32"
